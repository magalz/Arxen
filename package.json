{
  "name": "arxen",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=26.8.1 <27",
    "pnpm": "12.3.4"
  },
  "scripts": {
    "bootstrap": "pnpm install --frozen-lockfile && pnpm python:sync",
    "python:lock": "uv lock",
    "python:sync": "uv sync --locked --all-groups",
    "python:run": "uv run --locked",
    "dev:web": "vite --config apps/web/vite.config.ts --host 127.0.0.1",
    "dev:api": "uv run --locked uvicorn arxen_api.main:app --host 127.0.0.1 --port 8000",
    "preview:web": "vite preview --config apps/web/vite.config.ts --host 127.0.0.1 --port 4173 --strictPort",
    "build": "vite build --config apps/web/vite.config.ts",
    "lint:web": "eslint . --max-warnings 0",
    "lint:api": "uv run --locked ruff check .",
    "lint": "pnpm lint:web && pnpm lint:api",
    "format:web:check": "prettier . --check",
    "format:api:check": "uv run --locked ruff format --check .",
    "format:check": "pnpm format:web:check && pnpm format:api:check",
    "format": "prettier . --write && uv run --locked ruff format .",
    "typecheck:web": "tsc --noEmit",
    "typecheck:api": "uv run --locked mypy services/api/src",
    "typecheck": "pnpm typecheck:web && pnpm typecheck:api",
    "test:web": "vitest run --coverage",
    "test:web:watch": "vitest",
    "test:api": "uv run --locked pytest services/api/tests",
    "test:integration": "uv run --locked pytest tests/integration --no-cov",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:install:ci": "playwright install --with-deps chromium",
    "test": "pnpm test:web && pnpm test:api",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "check:all": "pnpm check && pnpm test:integration && pnpm test:e2e",
    "infra:up": "docker compose -f infra/compose.yaml up -d --wait",
    "infra:down": "docker compose -f infra/compose.yaml down"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
